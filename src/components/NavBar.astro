---
const links = [
  { href: '#tipos', label: 'Tipos' },
  { href: '#composicao', label: 'Composição' },
  { href: '#terminologia', label: 'Terminologia' },
  { href: '#girias', label: 'Gírias' },
  { href: '#mecanicas', label: 'Mecânicas' },
  { href: '#dicas', label: 'Dicas' },
];
---

<header class="sticky top-0 z-50 bg-surface/90 backdrop-blur-md border-b border-rim">
  <input type="checkbox" id="nav-toggle" class="peer sr-only" />

  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-center justify-between h-16">
      <a
        href="#"
        class="font-heading text-gold font-bold tracking-widest text-base hover:text-gold-light transition-colors"
      >
        FFXIV RAIDS
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Navegação principal">
        {links.map(link => (
          <a
            href={link.href}
            data-nav-link
            class="text-sm text-ash hover:text-gold transition-colors font-medium"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Mobile hamburger label -->
      <label
        for="nav-toggle"
        class="md:hidden cursor-pointer text-ash hover:text-gold transition-colors p-1"
        aria-label="Abrir menu"
      >
        <svg id="icon-menu" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
        <svg id="icon-close" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" class="hidden">
          <path d="M6 6l12 12M18 6l-12 12" stroke-linecap="round" />
        </svg>
      </label>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="peer-checked:block hidden md:hidden border-t border-rim bg-layer">
    <nav id="mobile-nav" class="max-w-6xl mx-auto px-6 py-4 flex flex-col gap-1" aria-label="Menu móvel">
      {links.map(link => (
        <a
          href={link.href}
          data-nav-link
          class="text-sm text-ash hover:text-gold transition-colors font-medium py-2 border-b border-rim/50 last:border-0"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle') as HTMLInputElement;
  const iconMenu = document.getElementById('icon-menu')!;
  const iconClose = document.getElementById('icon-close')!;

  toggle.addEventListener('change', () => {
    iconMenu.classList.toggle('hidden', toggle.checked);
    iconClose.classList.toggle('hidden', !toggle.checked);
  });

  document.querySelectorAll('#mobile-nav a').forEach(a => {
    a.addEventListener('click', () => {
      toggle.checked = false;
      iconMenu.classList.remove('hidden');
      iconClose.classList.add('hidden');
    });
  });

  // Scroll-spy: highlight active section in nav
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  const spy = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        navLinks.forEach(link => {
          link.removeAttribute('aria-current');
          if (link.getAttribute('href') === '#' + entry.target.id) {
            link.setAttribute('aria-current', 'page');
          }
        });
      });
    },
    { rootMargin: '-40% 0px -60% 0px' }
  );

  sections.forEach(s => spy.observe(s));
</script>
