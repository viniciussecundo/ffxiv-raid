---

<section id="mecanicas" class="py-20 px-6">
  <div class="max-w-6xl mx-auto reveal">
    <div class="text-center mb-14">
      <p class="font-heading text-gold text-xs tracking-[0.3em] uppercase mb-3">Seção 05</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-snow mb-4">Mecânicas Comuns</h2>
      <div class="section-divider max-w-xs mx-auto mt-6 mb-6"></div>
      <p class="text-ash max-w-xl mx-auto text-sm leading-relaxed">
        Todo raid recombina as mesmas mecânicas fundamentais de formas criativas. Clique em qualquer card para ver o diagrama.
      </p>
    </div>

    <!-- Savage combo note -->
    <div class="mb-10 border border-gold/20 rounded-xl px-6 py-4 bg-gold/5 flex gap-4 items-start max-w-3xl mx-auto">
      <span class="text-gold text-xl flex-shrink-0">⚠️</span>
      <p class="text-ash text-sm leading-relaxed">
        <span class="text-snow font-semibold">Em Savage e Ultimate, essas mecânicas raramente aparecem isoladas.</span>
        {' '}O desafio real é resolver 2 ou 3 simultâneas — ex: um Stack que acontece durante um Spread, dentro de uma fase de Towers, enquanto um Tether precisa ser posicionado. Aprender cada mecânica individualmente é o pré-requisito para entender como elas se combinam.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {mechanics.map(m => (
        <button
          data-open={`modal-${m.id}`}
          class={`rounded-xl border p-6 ${m.accent} flex flex-col gap-3 text-left cursor-pointer hover:brightness-110 transition-all group`}
        >
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-3">
              <span class="text-2xl" aria-hidden="true">{m.icon}</span>
              <h3 class="font-heading text-base font-bold">{m.name}</h3>
            </div>
            <span class="text-xs opacity-50 group-hover:opacity-100 transition-opacity font-heading">Ver diagrama →</span>
          </div>
          <p class="text-snow text-sm leading-relaxed">{m.desc}</p>
          <div class="bg-black/20 rounded-lg px-4 py-3 text-xs text-ash/80 font-mono">
            {m.visual}
          </div>
          <div class="flex gap-2 items-start pt-1">
            <span class="text-gold text-xs font-bold flex-shrink-0 font-heading">DICA</span>
            <p class="text-snow/70 text-xs leading-relaxed">{m.tip}</p>
          </div>
        </button>
      ))}
    </div>
  </div>
</section>

{mechanics.map(m => (
  <dialog id={`modal-${m.id}`} data-mechanic-modal>
    <div class="modal-inner">
      <div class="modal-header">
        <div class="flex items-center gap-3">
          <span class="text-xl" aria-hidden="true">{m.icon}</span>
          <h3 class="font-heading text-snow font-bold text-base">{m.name}</h3>
        </div>
        <button data-close class="modal-close" aria-label="Fechar">✕</button>
      </div>
      <div class="flex justify-center bg-black/20 rounded-xl p-4">
        <Fragment set:html={m.diagram} />
      </div>
      <p class="text-snow/80 text-sm leading-relaxed">{m.desc}</p>
      <div class="bg-black/20 rounded-lg px-4 py-3 text-xs text-ash/80 font-mono">
        {m.visual}
      </div>
      <div class="flex gap-2 items-start border-t border-rim pt-3">
        <span class="text-gold text-xs font-bold flex-shrink-0 font-heading">DICA</span>
        <p class="text-snow/70 text-xs leading-relaxed">{m.tip}</p>
      </div>
    </div>
  </dialog>
))}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.open;
      if (id) (document.getElementById(id) as HTMLDialogElement)?.showModal();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-close]').forEach(btn => {
    btn.addEventListener('click', () => {
      (btn.closest('dialog') as HTMLDialogElement)?.close();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('[data-mechanic-modal]').forEach(dialog => {
    dialog.addEventListener('click', e => {
      const r = dialog.getBoundingClientRect();
      if (
        e.clientX < r.left || e.clientX > r.right ||
        e.clientY < r.top  || e.clientY > r.bottom
      ) {
        dialog.close();
      }
    });
  });
</script>
