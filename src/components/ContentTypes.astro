---

<section id="tipos" class="py-20 px-6">
  <div class="max-w-6xl mx-auto reveal">
    <div class="text-center mb-14">
      <p class="font-heading text-gold text-xs tracking-[0.3em] uppercase mb-3">Seção 01</p>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-snow mb-4">Tipos de Conteúdo</h2>
      <div class="section-divider max-w-xs mx-auto mt-6 mb-6"></div>
      <p class="text-ash max-w-xl mx-auto text-sm leading-relaxed">
        Cada categoria tem sua curva de dificuldade, cultura e recompensas. Entender onde você está é o primeiro passo.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {types.map(type => (
        <div class="group bg-card border border-rim rounded-xl overflow-hidden hover:border-gold/40 transition-colors flex flex-col">
          <!-- Banner de imagem -->
          <div class="relative h-[120px] overflow-hidden flex-shrink-0">
            <img
              src={type.image}
              alt=""
              aria-hidden="true"
              loading="lazy"
              class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-110"
            />
            <div class="absolute inset-0" style={`background: linear-gradient(135deg, ${type.overlayColor} 0%, rgba(0,0,0,0.45) 100%)`} />
            <div class="absolute inset-0" style="background: linear-gradient(to bottom, transparent 40%, #1e2235 100%)" />
            <!-- SVG icon + nome sobre a imagem -->
            <div class="absolute bottom-3 left-4 flex items-center gap-2">
              <Fragment set:html={type.svgIcon} />
              <h3 class="font-heading text-xl font-bold text-gold drop-shadow">{type.name}</h3>
            </div>
          </div>

          <!-- Corpo do card -->
          <div class="p-5 flex flex-col gap-4 flex-1">
            <div class="flex items-center justify-between gap-3">
              <div class="flex gap-1.5" aria-label={`Dificuldade ${type.difficulty} de 4`}>
                {Array.from({ length: 4 }, (_, i) => (
                  <div class={`w-2 h-2 rounded-full ${i < type.difficulty ? 'bg-gold' : 'bg-rim'}`} />
                ))}
              </div>
              <span class={`text-xs font-semibold px-2 py-1 rounded border flex-shrink-0 ${type.badgeClass}`}>
                {type.badge}
              </span>
            </div>

            <p class="text-snow text-sm leading-relaxed flex-1">{type.description}</p>
            <p class="text-ash text-xs leading-relaxed border-t border-rim pt-4">{type.detail}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
