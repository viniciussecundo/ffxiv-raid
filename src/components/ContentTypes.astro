      <path d="M20 6c0 0-2 4-2 8 0 0-4-2-4-6 0 0-4 5-4 10a10 10 0 0 0 20 0c0-7-4-11-4-11 0 4-2 5-2 5s-4-3-4-6z" fill="#facc15" opacity="0.2" stroke="#facc15" stroke-width="1.5" stroke-linejoin="round"/>
      <circle cx="20" cy="24" r="3" fill="#facc15" opacity="0.35" stroke="#facc15" stroke-width="1"/>
    </svg>`,
  },
  {
    name: 'Criterion',
    badge: 'Variante',
    badgeClass: 'text-violet-400 border-violet-400/30 bg-violet-400/10',
    difficulty: 2,
    image: '/tier-normal.jpg',
    overlayColor: 'rgba(167,139,250,0.25)',
    description:
