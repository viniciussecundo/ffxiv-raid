  },
  {
    name: 'Ultimate',
    badge: 'Extremo',
    badgeClass: 'text-red-400 border-red-400/30 bg-red-400/10',
    difficulty: 4,
    image: '/tier-savage.jpg',
    overlayColor: 'rgba(248,113,113,0.25)',
    description:
