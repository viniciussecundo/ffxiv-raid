---
---

<section id="hero" class="relative min-h-screen flex items-center justify-center text-center px-6 py-24" style="background-image: url('https://images.unsplash.com/photo-1534796636912-3b95b3ab5986?w=1920&q=80'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 bg-surface/85 hero-gradient-overlay"></div>
  <div class="relative z-10 max-w-3xl mx-auto">
    <!-- Eyebrow -->
    <div class="flex items-center justify-center gap-3 mb-8">
      <div class="w-12 h-px bg-gold/50"></div>
      <span class="font-heading text-gold text-xs tracking-[0.3em] uppercase">Final Fantasy XIV</span>
      <div class="w-12 h-px bg-gold/50"></div>
    </div>

    <!-- Title -->
    <h1 class="font-heading text-5xl md:text-7xl font-bold text-snow leading-tight mb-6">
      Guia de<br /><span class="text-gold">Raids</span>
    </h1>

    <!-- Divider -->
    <div class="section-divider max-w-xs mx-auto mb-8"></div>

    <!-- Subtitle -->
    <p class="text-ash text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mb-10">
      Seja você um <span class="text-snow font-medium">aventureiro que nunca pisou em um raid</span> ou
      um veterano voltando ao jogo após uma pausa — este guia cobre tudo que você precisa saber
      antes de entrar na party.
    </p>

    <!-- CTA buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="#tipos"
        class="px-8 py-3 bg-gold text-surface font-semibold text-sm tracking-wider rounded hover:bg-gold-light transition-colors duration-200"
      >
        Começar o Guia
      </a>
      <a
        href="#terminologia"
        class="px-8 py-3 border border-gold/50 text-gold font-semibold text-sm tracking-wider rounded hover:bg-gold/10 hover:border-gold transition-colors duration-200"
      >
        Ver Terminologia
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-ash/40 animate-bounce z-10" aria-hidden="true">
    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path d="M12 5v14M5 12l7 7 7-7" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" />
    </svg>
  </div>
</section>
